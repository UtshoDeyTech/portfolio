# Django Backend Configuration
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-domain.com,your-ec2-ip,localhost,127.0.0.1,backend

# Database Configuration
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=/app/db.sqlite3

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://your-domain.com,https://your-domain.com

# API URLs
VITE_API_URL=http://your-domain.com/api
PUBLIC_API_URL=http://your-domain.com/api

# Astro Configuration
PUBLIC_SITE_URL=http://your-domain.com
