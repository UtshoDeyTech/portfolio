  .list-view {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Grid View Styles - Responsive */
  .grid-view {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr; /* Mobile: 1 column */
  }

  @media (min-width: 640px) {
    .grid-view {
      grid-template-columns: repeat(2, 1fr); /* Tablet: 2 columns */
    }
  }

  @media (min-width: 1024px) {
    .grid-view {
      grid-template-columns: repeat(3, 1fr); /* Desktop: 3 columns */
    }
  }

  /* Large View Styles - Always full width cards */
  .large-view {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
  }

  /* Responsive line clamping */
  @media (max-width: 640px) {
    .sm\:line-clamp-2 {
      -webkit-line-clamp: 3;
    }
  }

  @media (min-width: 640px) {
    .sm\:line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      word-break: break-word;
    }
  }

  /* Smooth transitions */
  .blog-item {
    transition: all 0.3s ease;
  }

  /* Button active state */
  .view-toggle.btn-active {
    background-color: hsl(var(--p));
    color: hsl(var(--pc));
  }

  /* Tab styles */
  .blog-tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  .blog-tab.tab-active {
    background-color: hsl(var(--p));
    color: hsl(var(--pc));
    font-weight: 600;
  }

  .blog-tab:hover:not(.tab-active) {
    background-color: hsl(var(--b3));
  }

  /* Responsive tabs */
  @media (max-width: 640px) {
    .tabs-boxed {
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .tabs-boxed::-webkit-scrollbar {
      display: none;
    }

    .blog-tab {
      padding: 0.5rem 0.75rem;
      font-size: 0.75rem;
      white-space: nowrap;
    }

    .blog-tab svg {
      margin: 0;
    }
  }

  /* Improved spacing for small screens */
  @media (max-width: 640px) {
    .list-view {
      gap: 0.5rem;
    }

    .grid-view {
      gap: 1rem;
    }

    .large-view {
      gap: 1rem;
    }
  }
</style>
